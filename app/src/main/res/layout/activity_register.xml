<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_white"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voltar ao início"
            android:textColor="@color/primary"
            android:textStyle="bold"
            app:drawableStartCompat="@android:drawable/ic_menu_revert"
            app:drawableTint="@color/primary"
            android:drawablePadding="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:srcCompat="@drawable/ic_egood_logo"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvVoltar"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Criar sua Conta"
            android:textSize="24sp"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/ivLogo"
            app:layout_constraintBottom_toBottomOf="@id/ivLogo"
            app:layout_constraintStart_toEndOf="@id/ivLogo"/>

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Junte-se à comunidade E-good"
            android:textColor="@color/text_gray"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/ivLogo"/>

        <LinearLayout
            android:id="@+id/cardContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:baselineAligned="false"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <LinearLayout
                android:id="@+id/cardPessoa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_card_selected">

                <ImageView
                    android:id="@+id/iconPessoa"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:srcCompat="@drawable/ic_person"
                    app:tint="@color/primary"/>

                <TextView
                    android:id="@+id/titlePessoa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pessoa"
                    android:textColor="@color/primary"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/descPessoa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usuário individual"
                    android:textSize="12sp"
                    android:textColor="@color/primary"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardConcessionaria"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_card_unselected">

                <ImageView
                    android:id="@+id/iconConcessionaria"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    app:srcCompat="@drawable/ic_store"
                    app:tint="@color/text_gray"/>

                <TextView
                    android:id="@+id/titleConcessionaria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Concessionária"
                    android:textColor="@color/text_dark"
                    android:textStyle="bold"
                    android:layout_marginTop="8dp"
                    android:textSize="16sp"/>

                <TextView
                    android:id="@+id/descConcessionaria"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Empresa de veículos"
                    android:textSize="12sp"
                    android:textColor="@color/text_gray"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/formPessoa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardContainer">

            <TextView
                android:id="@+id/labelNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOME COMPLETO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutNome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                app:startIconTint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Digite seu nome completo"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="textPersonName"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-MAIL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_dialog_email"
                app:startIconTint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="seu@email.com"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="textEmailAddress"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelSenha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENHA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                app:startIconTint="@color/text_gray"
                app:endIconTint="@color/text_gray"
                app:passwordToggleEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Digite sua senha"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="textPassword"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelConfSenha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRMAR SENHA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutConfSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                app:startIconTint="@color/text_gray"
                app:endIconTint="@color/text_gray"
                app:passwordToggleEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editConfSenha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Confirme sua senha"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="textPassword"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/formConcessionaria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/cardContainer">

            <TextView
                android:id="@+id/labelNomeEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOME DA EMPRESA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutNomeEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                app:startIconTint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editNomeEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Digite o nome da empresa"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="textPersonName"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelCnpj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CNPJ"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutCnpj"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_menu_agenda"
                app:startIconTint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCnpj"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="00.000.000/0000-00"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelEmailEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-MAIL"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutEmailEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_dialog_email"
                app:startIconTint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editEmailEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="empresa@email.com"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="textEmailAddress"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelSenhaEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENHA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutSenhaEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                app:startIconTint="@color/text_gray"
                app:endIconTint="@color/text_gray"
                app:passwordToggleEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editSenhaEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Digite sua senha"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="textPassword"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelConfSenhaEmpresa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONFIRMAR SENHA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutConfSenhaEmpresa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                app:startIconTint="@color/text_gray"
                app:endIconTint="@color/text_gray"
                app:passwordToggleEnabled="true">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editConfSenhaEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Confirme sua senha"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="textPassword"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelTelefone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TELEFONE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutTelefone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_menu_call"
                app:startIconTint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="(00) 00000-0000"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="phone"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/labelEndereco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ENDEREÇO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutEndereco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_menu_mapmode"
                app:startIconTint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editEndereco"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Rua, número, complemento"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="textPostalAddress"/>
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/labelCidade"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CIDADE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_gray"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutCidade"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="@color/background_app"
                        app:boxStrokeColor="@color/stroke_input">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editCidade"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Cidade"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                                                        android:inputType="textCapWords"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="8dp">

                    <TextView
                        android:id="@+id/labelEstado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ESTADO"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_gray"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/inputLayoutEstado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="@color/background_app"
                        app:boxStrokeColor="@color/stroke_input">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/editEstado"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="UF"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                                                        android:inputType="textCapCharacters"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/labelCep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CEP"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="16dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutCep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxBackgroundColor="@color/background_app"
                app:boxStrokeColor="@color/stroke_input"
                app:startIconDrawable="@android:drawable/ic_menu_compass"
                app:startIconTint="@color/text_gray">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editCep"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="00000-000"
                    android:textColor="@color/text_dark"
                    android:textColorHint="@color/text_gray"
                    android:textColorHighlight="@android:color/transparent"
                    android:inputType="number"/>
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/locationPessoaContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/formPessoa"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/labelLocalizacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCALIZAÇÃO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoLocation"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Usar minha localização automaticamente"
                android:textColor="@color/text_dark"
                android:gravity="start|center_vertical"
                app:icon="@android:drawable/ic_menu_mylocation"
                app:iconTint="@android:color/holo_red_dark"
                app:cornerRadius="12dp"
                app:strokeColor="@color/stroke_input"
                android:layout_marginTop="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualLocation"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="Selecionar localização manualmente"
                android:textColor="@color/text_dark"
                android:gravity="start|center_vertical"
                app:icon="@android:drawable/ic_menu_mapmode"
                app:iconTint="@color/primary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/stroke_input"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/locationConcessionariaContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/formConcessionaria"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/labelLocalizacaoConcessionariaContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOCALIZAÇÃO DA CONCESSIONÁRIA"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoLocationConcessionariaContainer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:text="Usar GPS / localização atual"
                android:textColor="@color/text_dark"
                android:gravity="start|center_vertical"
                app:icon="@android:drawable/ic_menu_mylocation"
                app:iconTint="@android:color/holo_red_dark"
                app:cornerRadius="12dp"
                app:strokeColor="@color/stroke_input"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManualLocationConcessionariaContainer"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="8dp"
                android:text="Selecionar no mapa manualmente"
                android:textColor="@color/text_dark"
                android:gravity="start|center_vertical"
                app:icon="@android:drawable/ic_menu_mapmode"
                app:iconTint="@color/primary"
                app:cornerRadius="12dp"
                app:strokeColor="@color/stroke_input"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCadastrar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Cadastrar"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/primary"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@id/locationPessoaContainer"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:layout_constraintTop_toBottomOf="@id/btnCadastrar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Já tem uma conta? "
                android:textColor="@color/text_gray"/>

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Entre aqui"
                android:textColor="@color/primary"
                android:textStyle="bold"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>